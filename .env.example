# ===== dsh-passwords 配置 =====
# 本文件在项目根目录，名为 .env（由 .env.example 复制而来）
# 部署后它位于服务器上，例如 /opt/dsh-mcp-platform/.env
# 修改后需重启网关进程（npm start）才生效

# ── 【必填】预设安装密钥（SETUP_KEY） ──────────────────────────
# 作用：网页"首次配置"时要求输入的安装密钥，防止陌生人抢先初始化你的平台
# 在哪里找到它：就是下面这一行的值（部署者自己设定的）
# 如何生成一个强随机值：
#   Linux/macOS: openssl rand -hex 24
#   Windows PowerShell: -join ((1..24) | ForEach-Object {'{0:x}' -f (Get-Random -Max 16)})
# 改完这个值后，网页首次配置页就要输入这个新值
SETUP_KEY=change-me-to-a-strong-random-key

# ── SQLite 数据库文件路径 ─────────────────────────────────────
# 无需安装 MySQL/MariaDB；首次启动自动建库建表
# 默认 <进程工作目录>/data/platform.db；备份 = 复制该文件
# MCP_DB_PATH=/opt/dsh-mcp-platform/data/platform.db

# ── 数据静态加密密钥（强烈推荐）──────────────────────────────
# 用户数据（用户名/IP/UA/审计详情）以 AES-256-GCM 静态加密存入 SQLite，
# 登录尝试表只存 HMAC 散列（不可逆）。留空则从 SETUP_KEY 派生密钥。
# 生成：openssl rand -hex 32
# ⚠ 一旦启用不可更改/删除：换密钥后历史数据无法解密。
#   备份数据库时务必同时备份本密钥（.env 随备份走）。
# MCP_DB_ENC_KEY=

# ── 登录网关 ──────────────────────────────────────────────────
# 网关端口三层配置（优先级从高到低）：
#   1. 启动参数:  node dist/index.js serve-gateway --port 9000
#   2. 环境变量:  MCP_GATEWAY_PORT=9000 node dist/index.js serve-gateway
#   3. 本文件:    MCP_GATEWAY_PORT=9000
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8080
MCP_GATEWAY_UPSTREAM=http://127.0.0.1:3080

# ── HTTPS（公网部署强烈推荐）────────────────────────────────
# MCP_GATEWAY_TLS_CERT + MCP_GATEWAY_TLS_KEY 都填时网关启用 HTTPS，
# 同时会话 Cookie 自动加 Secure 标志、响应加 HSTS 头。
# 自签证书一键生成（IP 部署用；有域名建议用 Let's Encrypt）：
#   openssl req -x509 -newkey rsa:2048 -keyout tls.key -out tls.crt \
#     -days 825 -nodes -subj "/CN=你的服务器IP" -addext "subjectAltName=IP:你的服务器IP"
# MCP_GATEWAY_TLS_CERT=/path/to/tls.crt
# MCP_GATEWAY_TLS_KEY=/path/to/tls.key

# ── HTTP→HTTPS 跳转端口（可选，仅 TLS 开启时生效）─────────────
# 设成 80 后，80 端口不再提供页面内容，所有请求 301 到 https://…
# 登录凭据与 Cookie 不再走明文 HTTP。留空/不设 = 关闭跳转。
# MCP_GATEWAY_REDIRECT_PORT=80

# ── JWT 签名密钥（可选）───────────────────────────────────
# 留空则自动由 SETUP_KEY 派生（重启会话不失效）
# MCP_JWT_SECRET=

# ── 登录页主题跟随 dsh（可选）────────────────────────────────
# 网关自动读取 <dsh home>/settings.yaml 的 ui-theme.preference
# （light/dark/system，默认 system），登录/配置页配色随之切换：
# 浅色 = dsh 默认简约白，深色 = dsh 暗色令牌。
# 只有网关与 dsh 不在同一台机器时才需要手动指定：
# MCP_DSH_SETTINGS_FILE=/path/to/dsh/settings.yaml
